# RoadShield AI service configuration (all variables use the AI_ prefix).
AI_MODEL_PATH=models/roadshield-rdd.onnx
AI_MODEL_CARD_PATH=models/model_card.json
AI_CONF_THRESHOLD=0.25
AI_LOW_CONFIDENCE=0.5
# Must equal app_private.settings.ai_signing_secret in the database. Never ship it in the app.
AI_SIGNING_SECRET=
AI_SUPABASE_URL=https://<project-ref>.supabase.co
AI_SUPABASE_PUBLISHABLE_KEY=
AI_RATE_LIMIT_PER_MINUTE=12
